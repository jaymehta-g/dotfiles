#!/usr/bin/env xonsh

NIXOS = "/etc/nixos"
DOTS = "/home/jay/dots"
HM = DOTS + "/.config/home-manager"

pushafter = True

def repo_dirty(repo):
	return $(git -C @(repo) status --porcelain).__len__() > 0

for repo in (NIXOS, DOTS):
	if repo_dirty(repo):
		echo "Tree dirty: " + repo
		git -C @(repo) diff HEAD

echo "trying to pull..."
for repo in (NIXOS, DOTS):
	git -C @(repo) pull --ff-only

def autoformat():
	echo "Formatting..."
	for d in (NIXOS, HM):
		pushd @(d)
		if ![treefmt].returncode != 0:
			echo "Formatting failed in " + d
			popd
			return False
		popd
	return True

def hm_gen():
	line = $(home-manager generations).splitlines()[0]
	return line.split("id ")[1].split()[0]

def push():
	msgs = []
	# nixos repo: commit everything with generation message
	pushd @(NIXOS)
	gens = $(@lines nixos-rebuild list-generations)[1].split()
	nmsg = f"❄️  {$(uname -n)} gen {gens[0]}, channel {gens[3]}"
	git add .
	if ![git diff --cached --quiet].returncode != 0:
		git commit -m @(nmsg)
		msgs.append(nmsg)
	popd
	# dots repo: commit only the home-manager config
	pushd @(DOTS)
	git add .config/home-manager
	if ![git diff --cached --quiet].returncode != 0:
		hmsg = f"🏠 {$(uname -n)} hm gen {hm_gen()}"
		git commit -m @(hmsg)
		msgs.append(hmsg)
	popd
	for repo in (NIXOS, DOTS):
		git -C @(repo) push
	return "\n".join(msgs)

def rebuild():
	if not autoformat(): return
	echo "Applying system config..."
	if ![sudo nixos-rebuild switch --log-format internal-json -v 2>&1 | sudo nom --json].returncode != 0:
		echo "Error rebuilding"
		notify-send -e "Rebuild Failed (system) 💔💔💔"
		return
	echo "Applying home config..."
	if ![home-manager switch --flake ~/.config/home-manager].returncode != 0:
		echo "Error with home-manager"
		notify-send -e "Rebuild Failed (home-manager) 💔💔💔"
		return
	msg = ""
	if pushafter:
		msg = push()
	notify-send -e "Nix Rebuild Ok 🤠" f"{msg}"
	exit

while True:
	echo "e: Open Editor"
	echo "f: Autoformat"
	echo "d: Print Diff"
	echo "a: Apply"
	echo "u: Update and Apply"
	echo @(f"p: Toggle Push (currently {pushafter})")
	resp = input(">>> ").strip()
	if resp == 'e':
		code -n @(NIXOS) @(DOTS)
	if resp == 'u':
		pushd @(NIXOS)
		nix flake update
		popd
		pushd @(HM)
		nix flake update
		popd
	if resp == 'a' or resp == 'u':
		rebuild()
	if resp == 'p':
		pushafter = (not pushafter)
	if resp == 'd':
		git -C @(NIXOS) diff HEAD
		git -C @(DOTS) diff HEAD
	if resp == 'f':
		autoformat()
